<mxfile host="drawio" agent="build_c4.py" version="24.7.0"><diagram id="ctx" name="1. Контекст (C4 L1)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1230" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx_v1" value="&lt;b&gt;Мини-облако: диаграмма контекста&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4d5b6a&quot;&gt;Модель C4, уровень 1 (System Context)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="900" height="48" as="geometry"/></mxCell><mxCell id="ctx_v2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Пользователь&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Хранит файлы, загружает их с телефона и ноутбука, делится ссылками&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="30" y="320" width="200" height="190" as="geometry"/></mxCell><mxCell id="ctx_v3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Гость&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Получает ссылку и скачивает файл без регистрации&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="510" y="70" width="200" height="190" as="geometry"/></mxCell><mxCell id="ctx_v4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Администратор&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Заводит учётные записи, следит за квотами и резервными копиями&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="200" height="190" as="geometry"/></mxCell><mxCell id="ctx_v5" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Мини-облако&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Программная система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Хранение файлов: папки, загрузка с докачкой, корзина на 30 дней, гостевые ссылки&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="300" height="170" as="geometry"/></mxCell><mxCell id="ctx_v6" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Хранилище резервных копий&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;S3-совместимое хранилище в другом дата-центре, куда уходят ночные копии&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="300" height="150" as="geometry"/></mxCell><mxCell id="ctx_e7" value="&lt;b&gt;Загружает, упорядочивает&lt;br&gt;и скачивает файлы,&lt;br&gt;создаёт ссылки&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx_v2" target="ctx_v5"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ctx_e8" value="&lt;b&gt;Скачивает файл&lt;br&gt;по ссылке&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx_v3" target="ctx_v5"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ctx_e9" value="&lt;b&gt;Заводит учётные записи,&lt;br&gt;меняет квоты&lt;/b&gt;&lt;br&gt;[SSH, консольная&lt;br&gt;команда]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx_v4" target="ctx_v5"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ctx_e10" value="&lt;b&gt;Отправляет зашифрованные&lt;br&gt;копии базы и файлов&lt;/b&gt;&lt;br&gt;[S3 API, HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx_v5" target="ctx_v6"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ctx_v11" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#9aa7b8;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="300" height="112" as="geometry"/></mxCell><mxCell id="ctx_v12" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="666" width="200" height="20" as="geometry"/></mxCell><mxCell id="ctx_v13" value="" style="rounded=1;arcSize=12;fillColor=#08427B;strokeColor=#073B6F;" vertex="1" parent="1"><mxGeometry x="42" y="692" width="44" height="18" as="geometry"/></mxCell><mxCell id="ctx_v14" value="Человек" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="96" y="691" width="225" height="20" as="geometry"/></mxCell><mxCell id="ctx_v15" value="" style="rounded=1;arcSize=12;fillColor=#1168BD;strokeColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="42" y="718" width="44" height="18" as="geometry"/></mxCell><mxCell id="ctx_v16" value="Проектируемая система" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="96" y="717" width="225" height="20" as="geometry"/></mxCell><mxCell id="ctx_v17" value="" style="rounded=1;arcSize=12;fillColor=#999999;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="42" y="744" width="44" height="18" as="geometry"/></mxCell><mxCell id="ctx_v18" value="Внешняя система" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="96" y="743" width="225" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cnt" name="2. Контейнеры (C4 L2)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1590" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cnt_v1" value="&lt;b&gt;Мини-облако: диаграмма контейнеров&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4d5b6a&quot;&gt;Модель C4, уровень 2 (Container). Модульный монолит: API и фоновый обработчик собираются из одного кода&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="900" height="48" as="geometry"/></mxCell><mxCell id="cnt_v2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Пользователь&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Работает с файлами в браузере или в установленной PWA&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="180" as="geometry"/></mxCell><mxCell id="cnt_v3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Гость&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Открывает гостевую ссылку&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="228" y="70" width="190" height="180" as="geometry"/></mxCell><mxCell id="cnt_v4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Администратор&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Обслуживает сервер: учётные записи, квоты, копии&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="935" y="70" width="190" height="180" as="geometry"/></mxCell><mxCell id="cnt_v5" value="&lt;b&gt;Мини-облако&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Программная система]&lt;/font&gt;" style="rounded=1;arcSize=2;absoluteArcSize=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;html=1;whiteSpace=wrap;fontSize=12;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="310" width="1545" height="540" as="geometry"/></mxCell><mxCell id="cnt_v6" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;PWA-клиент&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: TypeScript, React]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Интерфейс в браузере. Хэш и загрузка частей в Web Worker, очередь загрузок в IndexedDB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="290" height="160" as="geometry"/></mxCell><mxCell id="cnt_v7" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Веб-сервер&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: Nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLS, статика PWA, прокси к API и к S3, ограничение частоты запросов&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="260" height="160" as="geometry"/></mxCell><mxCell id="cnt_v8" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: Python 3.13, FastAPI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;REST API /api/v1: вход, дерево папок, сессии загрузки, ссылки, лента изменений&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="360" width="250" height="160" as="geometry"/></mxCell><mxCell id="cnt_v9" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;База метаданных&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: PostgreSQL 18]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Пользователи, дерево узлов, загрузки, ссылки, журнал; очередь задач Procrastinate&lt;/font&gt;" style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1305" y="345" width="240" height="190" as="geometry"/></mxCell><mxCell id="cnt_v10" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Файловое хранилище&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: Garage, S3 API]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Содержимое файлов и превью; составные (multipart) загрузки&lt;/font&gt;" style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="640" width="260" height="180" as="geometry"/></mxCell><mxCell id="cnt_v11" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Фоновый обработчик&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Контейнер: Python 3.13, Procrastinate]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Проверка хэша, превью, очистка корзины, отмена просроченных загрузок&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="650" width="250" height="160" as="geometry"/></mxCell><mxCell id="cnt_v12" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Хранилище резервных копий&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;S3-совместимое хранилище в другом дата-центре&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="900" width="300" height="130" as="geometry"/></mxCell><mxCell id="cnt_e13" value="&lt;b&gt;Работает с файлами&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.224;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cnt_v2" target="cnt_v6"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="cnt_e14" value="&lt;b&gt;Открывает ссылку&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.941;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cnt_v3" target="cnt_v6"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="cnt_e15" value="&lt;b&gt;JSON-запросы к API,&lt;br&gt;части файлов&lt;br&gt;и скачивание&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#707070;strokeWidth=1.3;fontSize=11;fon
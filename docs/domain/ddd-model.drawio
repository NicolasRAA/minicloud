<mxfile host="drawio" agent="pr3-generator" version="24.0.0"><diagram id="p1" name="Карта контекстов"><mxGraphModel dx="1180" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Мини-облако: карта контекстов&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="24" as="geometry"/></mxCell><mxCell id="v2" value="&lt;font color=&quot;#555555&quot;&gt;ПР3, DDD. Стрелка идёт от поставщика (upstream) к потребителю (downstream). Коды С1–С11 совпадают с таблицей связей в отчёте.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1140" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;PWA-клиент&lt;/b&gt;&lt;br&gt;[умный клиент]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="240" height="60" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Мини-облако&lt;/b&gt; · модульный монолит: один образ, API и фоновый обработчик" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1140" height="590" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Вход&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quo
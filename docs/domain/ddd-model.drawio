ace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="98" y="819" width="244" height="18" as="geometry"/></mxCell><mxCell id="e33" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=1.8;dashed=1;dashPattern=7 4;rounded=0;fontColor=#8A4B00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="32" y="852" as="sourcePoint"/><mxPoint x="90" y="852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="доменное событие" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="98" y="843" width="244" height="18" as="geometry"/></mxCell><mxCell id="e35" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=none;strokeColor=#8A8A8A;strokeWidth=1.2;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="32" y="876" as="sourcePoint"/><mxPoint x="90" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v36" value="контекст пользуется адаптером" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="98" y="867" width="244" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Агрегат «Загрузка»"><mxGraphModel dx="1120" dy="788" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="788" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Агрегат «Загрузка» (контекст «Загрузка»)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="24" as="geometry"/></mxCell><mxCell id="v2" value="&lt;font color=&quot;#555555&quot;&gt;Пунктирная рамка: граница агрегата, всё внутри меняется одной транзакцией. Серые блоки снаружи: другие агрегаты и внешние системы, на них ссылаемся только по ID.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1080" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Граница агрегата «Загрузка»&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#D5E8D4;opacity=60;dashed=1;dashPattern=10 5;strokeColor=#82B366;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="700" height="400" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style='font-size:14px'&gt;Загрузка&lt;/b&gt; [корень]&lt;br&gt;&lt;font style='font-size:11px'&gt;знает, какие части приняты и можно ли собрать файл&lt;br&gt;&lt;i&gt;почему корень:&lt;/i&gt; если менять части в обход неё, файл можно «завершить» с дырой, как в R35&lt;br&gt;&lt;br&gt;&lt;i&gt;операции:&lt;/i&gt;&lt;br&gt;start() · missingParts()&lt;br&gt;complete() · abort() · expire()&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="112" width="290" height="200" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Часть&lt;/b&gt; [сущность]&lt;br&gt;&lt;font style='font-size:11px'&gt;номер 1…10 000, размер,&lt;br&gt;принята или нет; список берётся&lt;br&gt;у хранилища через ACL&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="112" width="300" height="92" as="geometry"/></mxCell><mxCell id="e6" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;strokeColor=#0B4884;strokeWidth=1.5;exitX=0;exitY=0.230;entryX=1;entryY=0.5;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="1 : N" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="348" y="136.0" width="66" height="20" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Объекты-значения&lt;/b&gt; (неизменяемые)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="44" y="330" width="656" height="134" as="geometry"/></mxCell><mxCell id="v9" value="Отпечаток&lt;br&gt;SHA-256 блоков по 4 МиБ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v10" value="Размер файла&lt;br&gt;до 50 ГиБ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v11" value="Имя файла" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="482" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v12" value="Нарезка&lt;br&gt;части по 8 МиБ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="408" width="202" height="44" as="geometry"/></mxCell><mxCell id="v13" value="Срок жизни&lt;br&gt;7 дней от начала" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="408" width="202" height="44" as="geometry"/></mxCell><mxCell id="v14" value="Учётная запись · владелец [Вход]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="92.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e15" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.000;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v14"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="Папка назначения [Файлы]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="142.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e17" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.250;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v16"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="Место в облаке · резерв [Файлы]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="192.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e19" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.500;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v18"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="Многочастная загрузка S3 [за ACL]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="242.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e21" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.750;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v20"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v22" value="Файл · ID выдан заранее, файл создаётся по событию [Файлы]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="292.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e23" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=1.000;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v22"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="&lt;b&gt;Жизненный цикл корня&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="400" height="20" as="geometry"/></mxCell><mxCell id="v25" value="идёт" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v26" value="завершается" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v27" value="завершена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v28" value="отменена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="570" width="150" height="34" as="geometry"/></mxCell><mxCell id="v29" value="просрочена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="616" width="150" height="34" as="geometry"/></mxCell><mxCell id="e30" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v25" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v25" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v34" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;И1. Файл появляется, только когда хранилище приняло все части (Г5, R35)&lt;br&gt;И2. Одна незавершённая загрузка на содержимое, папку и имя: повтор продолжает её (Г6, R10, R39)&lt;br&gt;И3. Повторное «завершить» возвращает тот же файл (Г4, ИП-3)&lt;br&gt;И4. Байты идут только при зарезервированном месте; через 7 дней загрузка просрочена (Г3, ИП-5)&lt;br&gt;И5. Есть проверенное содержимое с тем же отпечатком: байты не передаются (Г2, R43)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#FFFBE6;strokeColor=#D6B656;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1080" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Агрегат «Файл»"><mxGraphModel dx="1120" dy="742" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="742" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Агрегат «Файл» (контекст «Файлы»)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="24" as="geometry"/></mxCell><mxCell id="v2" value="&lt;font color=&quot;#555555&quot;&gt;Пунктирная рамка: граница агрегата, всё внутри меняется одной транзакцией. Серые блоки снаружи: другие агрегаты и внешние системы, на них ссылаемся только по ID.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1080" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Граница агрегата «Файл»&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#DAE8FC;opacity=60;dashed=1;dashPattern=10 5;strokeColor=#6C8EBF;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="700" height="400" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style='font-size:14px'&gt;Файл&lt;/b&gt; [корень]&lt;br&gt;&lt;font style='font-size:11px'&gt;защищает судьбу файла: когда его можно открыть и как он может покинуть облако&lt;br&gt;&lt;i&gt;почему корень:&lt;/i&gt; только он решает, можно ли скачать, поделиться и удалить навсегда&lt;br&gt;&lt;br&gt;&lt;i&gt;операции:&lt;/i&gt;&lt;br&gt;add() · markAvailable() · markCorrupted()&lt;br&gt;rename() · move() · trash() · restore() · purge()&lt;br&gt;open() · download() · ensureShareable()&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="112" width="290" height="200" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Внутренних сущностей нет&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;всё, что меняется вместе с файлом, описано значениями: Вернон советует ограничивать агрегат корнем и значениями&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="112" width="330" height="96" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Объекты-значения&lt;/b&gt; (неизменяемые)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="44" y="330" width="656" height="134" as="geometry"/></mxCell><mxCell id="v7" value="Имя&lt;br&gt;1–255 символов, без «/», NFC" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v8" value="Отпечаток и размер&lt;br&gt;содержимого" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v9" value="Пребывание в корзине&lt;br&gt;когда, до какого дня, откуда" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="482" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v10" value="Версия&lt;br&gt;для If-Match" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="408" width="202" height="44" as="geometry"/></mxCell><mxCell id="v11" value="Даты файла&lt;br&gt;«загружен», «изменён на устройстве»" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="408" width="202" height="44" as="geometry"/></mxCell><mxCell id="v12" value="Учётная запись · владелец [Вход]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="117.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e13" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.125;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v12"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v14" value="Папка · где лежит [Файлы]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="167.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e15" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.375;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v14"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="Содержимое: помнит, какие файлы хранит [Проверка и превью]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="217.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e17" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=0;exitY=0.5;entryX=1;entryY=0.625;fontSize=10;" edge="1" parent="1" source="v16" target="v4"><mxGeometry relative="1" x="-0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="Загрузка: знает ID будущего файла [Загрузка]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="267.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e19" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=0;exitY=0.5;entryX=1;entryY=0.875;fontSize=10;" edge="1" parent="1" source="v18" target="v4"><mxGeometry relative="1" x="-0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;Жизненный цикл корня&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="400" height="20" as="geometry"/></mxCell><mxCell id="v21" value="проверяется" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v22" value="доступен" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v23" value="в корзине" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v24" value="удалён навсегда" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v25" value="повреждён" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="570" width="150" height="34" as="geometry"/></mxCell><mxCell id="e26" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v23" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="восстановить" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="v23" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455.0" y="510"/><mxPoint x="275.0" y="510"/></Array></mxGeometry></mxCell><mxCell id="v31" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;И1. Открыть, скачать и поделиться можно только доступным файлом (Г5, R30)&lt;br&gt;И2. Файл покидает облако только через корзину; «удалить навсегда» только из корзины (Г5, R32, R35, R41)&lt;br&gt;И3. Повторное «удалить» ничего не меняет и ошибкой не считается (Г4, ИП-3)&lt;br&gt;И4. Изменение применяется, только если пользователь видел текущую версию (Г4)&lt;br&gt;И5. Любое изменение попадает в историю той же транзакцией (Г4, ИП-3, R32)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#FFFBE6;strokeColor=#D6B656;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="624" width="1080" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Агрегат «Сеанс входа»"><mxGraphModel dx="1120" dy="774" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="774" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Агрегат «Сеанс входа» (контекст «Вход»)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="24" as="geometry"/></mxCell><mxCell id="v2" value="&lt;font color=&quot;#555555&quot;&gt;Пунктирная рамка: граница агрегата, всё внутри меняется одной транзакцией. Серые блоки снаружи: другие агрегаты и внешние системы, на них ссылаемся только по ID.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1080" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Граница агрегата «Сеанс входа»&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#E1D5E7;opacity=60;dashed=1;dashPattern=10 5;strokeColor=#9673A6;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="700" height="400" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style='font-size:14px'&gt;Сеанс входа&lt;/b&gt; [корень]&lt;br&gt;&lt;font style='font-size:11px'&gt;держит цепочку ключей продления: действует один ключ, повтор нужно отличить от кражи&lt;br&gt;&lt;br&gt;&lt;i&gt;операции:&lt;/i&gt;&lt;br&gt;start() · refresh()&lt;br&gt;end() · revoke()&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="112" width="290" height="200" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Цепочка ключей&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="44" y="108" width="320" height="20" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Ключ продления №1&lt;/b&gt; [сущность]&lt;br&gt;&lt;font style='font-size:11px'&gt;заменён в 10:15&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="132" width="300" height="44" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;strokeColor=#0B4884;strokeWidth=1.5;exitX=0;exitY=0.210;entryX=1;entryY=0.5;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="1 : N" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;spacing=2;" vertex="1" parent="1"><mxGeometry x="348" y="132.0" width="66" height="20" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Ключ продления №2&lt;/b&gt; [сущность]&lt;br&gt;&lt;font style='font-size:11px'&gt;заменён в 10:30&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="190" width="300" height="44" as="geometry"/></mxCell><mxCell id="e10" value="заменён на" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0B4884;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;Ключ продления №3&lt;/b&gt; [сущность]&lt;br&gt;&lt;font style='font-size:11px'&gt;действует сейчас&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="248" width="300" height="44" as="geometry"/></mxCell><mxCell id="e12" value="заменён на" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#0B4884;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v13" value="&lt;b&gt;Объекты-значения&lt;/b&gt; (неизменяемые)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="44" y="330" width="656" height="134" as="geometry"/></mxCell><mxCell id="v14" value="Устройство&lt;br&gt;описание браузера" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v15" value="Срок сеанса&lt;br&gt;30 дней с продления" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v16" value="Окно повтора&lt;br&gt;30 секунд" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="482" y="356" width="202" height="44" as="geometry"/></mxCell><mxCell id="v17" value="Отпечаток ключа&lt;br&gt;SHA-256, сам ключ не хранится" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#438DD5;strokeWidth=1.5;fontColor=#0B4884;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="408" width="202" height="44" as="geometry"/></mxCell><mxCell id="v18" value="Учётная запись [Вход]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="192.0" width="320" height="40" as="geometry"/></mxCell><mxCell id="e19" value="по ID" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#8A8A8A;strokeWidth=1.2;dashed=1;dashPattern=3 3;fontColor=#555555;exitX=1;exitY=0.500;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="v4" target="v18"><mxGeometry relative="1" x="0.05" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;Жизненный цикл корня&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="400" height="20" as="geometry"/></mxCell><mxCell id="v21" value="действует" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v22" value="завершён" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="v23" value="истёк" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="570" width="150" height="34" as="geometry"/></mxCell><mxCell id="v24" value="отозван" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="616" width="150" height="34" as="geometry"/></mxCell><mxCell id="e25" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v28" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;И1. Действует только последний выданный ключ продления (Г9)&lt;br&gt;И2. Старый ключ в течение 30 с: повтор; позже: кража, закрывается только этот сеанс (Г9, R3)&lt;br&gt;И3. Сбой приложения не завершает сеанс: только «выйти», срок, кража или отключение (ИП-2)&lt;br&gt;И4. Отключённая учётная запись не продлевает ни один сеанс" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=3;fillColor=#FFFBE6;strokeColor=#D6B656;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1080" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="Компоненты"><mxGraphModel dx="1420" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Мини-облако: компоненты и ограниченные контексты&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1380" height="24" as="geometry"/></mxCell><mxCell id="v2" value="&lt;font color=&quot;#555555&quot;&gt;Цвет модуля совпадает с цветом контекста на карте. Сплошная линия: синхронный вызов; оранжевый пунктир: доменное событие через журнал; зелёный пунктир: байты файла мимо API.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1380" height="34" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;PWA-клиент&lt;/b&gt;&lt;br&gt;[умный клиент: React, TypeScript]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="470" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Очередь загрузок&lt;/b&gt;&lt;br&gt;IndexedDB: что докачать после обрыва" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;fontColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="62" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Отпечаток файла&lt;/b&gt;&lt;br&gt;Web Worker, блоки по 4 МиБ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;fontColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="260" height="62" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Проверки по глоссарию&lt;/b&gt;&lt;br&gt;имя, размер, свободное место" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;fontColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="260" height="62" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Кэш папок&lt;/b&gt;&lt;br&gt;и курсор истории" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;fontColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="260" height="62" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Web Locks&lt;/b&gt;&lt;br&gt;продление сеанса без гонки вкладок" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=11;fontColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="40" y="474" width="260" height="62" as="geometry"/></mxCell><mxCell id="v9" value="&lt;i&gt;Окончательно решает сервер: клиент недоверенная сторона (лекция 4)&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="576" width="300" height="50" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Сервер «Мини-облака»&lt;/b&gt; · модульный монолит: FastAPI и Procrastinate, один образ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="90" width="680" height="760" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;API /api/v1&lt;/b&gt; · Open Host Service: команды и запросы клиента" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="640" height="46" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Вход&lt;/b&gt; · модуль auth&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;агрегаты: Учётная запись, Сеанс входа&lt;br&gt;схема БД: auth&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="194" width="310" height="112" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Гостевой доступ&lt;/b&gt; · модуль shares&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;агрегаты: Гостевая ссылка&lt;br&gt;схема БД: shares&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="194" width="310" height="112" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Файлы&lt;/b&gt; · модуль files&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;агрегаты: Папка, Файл, Место в облаке&lt;br&gt;схема БД: files&lt;br&gt;история: номера по владельцу, без пропусков&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="324" width="310" height="112" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b style=&quot;font-size:13px&quot;&gt;Загрузка&lt;/b&gt; · модуль uploads&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;агрегаты: Загрузка&lt;br&gt;схема БД: uploads&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="324" width="310" height="112" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Журнал событий&lt;/b&gt; (events.journal) · transactional outbox: событие пишется той же транзакцией, что и изменение агрегата&lt;br&gt;&lt;font style='font-size:11px'&gt;Procrastinate доставляет подписчикам: UploadCompleted, ContentVerified, FilePurged, AccountCreated и другие&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF3E0;strokeColor=#E07B00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="462" width="640" height="74" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b style=&quot;font-size:13px&quot;&gt;Проверка и превью&lt;/b&gt; · модуль content&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;агрегаты: Содержимое&lt;br&gt;схема БД: content&lt;br&gt;в фоне: проверка отпечатка, превью&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="572" width="310" height="112" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Адаптер хранилища&lt;/b&gt; · модуль storage&lt;br&gt;&lt;font style='font-size:11px'&gt;Anticorruption Layer: «часть», «принятые части», «собрать файл», «ссылка на скачивание» ↔ S3 API&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="572" width="310" height="112" as="geometry"/></mxCell><mxCell id="v19" value="&lt;i&gt;Модули общаются только через публичные интерфейсы и события; правило проверяет import-linter. Каждый контекст пишет только в свою схему базы. Подписчики Гостевого доступа и Места в облаке получают FilePurged так же, через журнал.&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="390" y="708" width="640" height="110" as="geometry"/></mxCell><mxCell id="e20" value="публикует" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=1.8;dashed=1;dashPattern=7 4;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#8A4B00;exitX=0.5;exitY=1;entryX=0.74;entryY=0;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="доставляет" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=1.8;dashed=1;dashPattern=7 4;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#8A4B00;exitX=0.26;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="v16" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="доставляет" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=1.8;dashed=1;dashPattern=7 4;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#8A4B00;exitX=0.26;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v23" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;схемы по контекстам:&lt;br&gt;auth · files · uploads&lt;br&gt;content · shares&lt;br&gt;&lt;br&gt;events: журнал событий&lt;br&gt;и очередь задач&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="270" height="320" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Garage (S3)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;бакеты:&lt;br&gt;содержимое файлов,&lt;br&gt;превью&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1120" y="500" width="270" height="170" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Хранилище резервных копий&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[внешнее, Conformist]&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="760" width="270" height="80" as="geometry"/></mxCell><mxCell id="e26" value="JSON по HTTPS" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.113;entryX=0;entryY=0.5;" edge="1" parent="1" source="v3" target="v11"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e27" value="SQL" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.199;entryX=0;entryY=0.38;" edge="1" parent="1" source="v10" target="v23"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e28" value="S3 API" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.753;" edge="1" parent="1" source="v18" target="v24"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e29" value="части файла по подписанным ссылкам, мимо API" style="html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=1.8;dashed=1;dashPattern=1 3;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#1B5E20;exitX=0.5;exitY=0;entryX=0.15;entryY=0;" edge="1" parent="1" source="v3" target="v24"><mxGeometry relative="1" x="-0.15"